<!--
  Locked 2:3 portrait tile (aspect 0.667) with a typographic caption
  below. Tile height follows the spanCount-derived width and
  AspectClampedImageView's smart-crop rule (CENTER_CROP when source
  ratio ∈ (0.5, 0.8), else FIT_CENTER) keeps long horizontal scans
  from getting heads-and-feet sliced.

  Page number is rendered as a caption below the image rather than as
  an overlay badge — gives the grid an art-gallery feel and lets the
  number stay legible against arbitrary thumbnail content without a
  translucent plate sitting on top of every tile.

  Ripple/foreground lives on the outer LinearLayout so a tap anywhere
  inside the cell (image OR caption) gives feedback.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:orientation="vertical"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <com.hippo.ehviewer.ui.widget.AspectClampedImageView
        android:id="@+id/page_thumb_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:aspect="0.667"
        app:minAspect="0.5"
        app:maxAspect="0.8"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/page_thumb_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="1dp"
        android:gravity="center"
        android:textColor="?attr/textColorThemePrimary"
        android:textSize="12sp"/>

</LinearLayout>
