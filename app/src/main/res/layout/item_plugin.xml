<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/keyline_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/keyline_margin"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/plugin_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/text_little_small" />

    <TextView
        android:id="@+id/plugin_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/plugin_login_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/plugin_tags_login_hint"
        android:textColor="?attr/textColorThemeAccent"
        android:visibility="gone" />
</LinearLayout>
