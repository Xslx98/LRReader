<?xml version="1.0" encoding="utf-8"?>
<!-- Continue-reading home-screen widget (issue #9). RemoteViews-safe views
     only; colors are concrete @color references (theme attrs are unavailable
     in the launcher process) with values-night variants for system dark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appwidget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/appwidget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/appwidget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appwidget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/shortcut_continue_reading"
            android:textColor="@color/appwidget_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/appwidget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/appwidget_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/appwidget_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/appwidget_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/appwidget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/appwidget_continue_reading_empty"
            android:textColor="@color/appwidget_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
