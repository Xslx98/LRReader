<?xml version="1.0" encoding="utf-8"?>
<!-- "+N" tail card of the tank detail members strip: the members beyond the
     first 8 fold into it; tapping opens member management. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/gallery_list_thumb_width"
    android:layout_height="@dimen/gallery_list_thumb_height"
    android:layout_marginEnd="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/member_more"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="?attr/textColorThemeAccent"
        android:textSize="@dimen/text_little_large"
        android:textStyle="bold"/>

</FrameLayout>
