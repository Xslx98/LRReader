<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    style="@style/CardView.Reactive">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.hippo.ehviewer.widget.FixedThumb
                android:id="@+id/thumb"
                android:layout_width="@dimen/gallery_list_thumb_width"
                android:layout_height="@dimen/gallery_list_thumb_height"
                app:retryType="longClick"
                app:minAspect="0.333"
                app:maxAspect="1.333"/>


            <TextView
                android:id="@+id/title"
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_toEndOf="@id/thumb"/>

            <TextView
                android:id="@+id/uploader"
                style="@style/CardMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/title"
                android:layout_below="@id/title"
                android:layout_marginTop="2dp"/>

            <!--
              source_server is pinned 8dp above thumb's bottom edge for a
              consistent bottom-anchored visual. rating sits directly
              above with a 2dp gap so the rating-badge pair keeps a fixed
              vertical position regardless of title/uploader length.

              Imported-archive case: when category becomes VISIBLE it
              uses the same alignBottom anchor; DownloadAdapter
              dynamically lifts source_server's bottomMargin in code to
              clear category in that path (rare branch, no XML cost on
              the main flow).

              Typography references: Apple footnote (13pt) + Material
              label-medium for size; Apple All-Caps Tracking +0.05em for
              letterSpacing; Material chip compact padding for 10dp/4dp;
              iOS Continuous-Curve small-chip 4dp corner radius.

              Top stack (title + uploader) is bounded by
              CardTitle.maxLines=2 + CardMessage.maxLines=1, so it
              cannot grow into the bottom region.
            -->
            <com.hippo.ehviewer.widget.SimpleRatingView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/title"
                android:layout_above="@id/source_server"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/source_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/title"
                android:layout_alignBottom="@id/thumb"
                android:layout_marginBottom="8dp"
                android:background="@drawable/lrr_server_badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/category"
                style="@style/CardMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/title"
                android:layout_alignBottom="@id/thumb"
                android:layout_marginBottom="8dp"
                android:paddingBottom="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:textColor="@android:color/white"
                android:textAllCaps="true"/>

            <TextView
                android:id="@+id/read_progress"
                style="@style/ReadProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/thumb"
                android:layout_toEndOf="@id/category"
                android:layout_marginBottom="8dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true" />

            <FrameLayout
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/thumb"
                android:layout_alignParentEnd="true"
                android:paddingEnd="8dp"
                tools:ignore="RtlSymmetry">

                <!-- 48dp min touch target (RES-2); 12dp padding keeps the icon
                     at 24dp so the card's visual density is unchanged. -->
                <ImageView
                    android:id="@+id/start"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_start_download"
                    app:srcCompat="@drawable/v_play_x24"/>

                <ImageView
                    android:id="@+id/stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_stop_download"
                    app:srcCompat="@drawable/v_pause_x24"/>

            </FrameLayout>

            <TextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/actions"
                android:layout_marginBottom="4dp"
                android:layout_alignParentEnd="true"
                android:paddingEnd="16dp"
                tools:ignore="RtlSymmetry"
                android:textColor="?attr/textColorThemeAccent"/>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/title"
                android:layout_marginEnd="8dp"
                android:layout_above="@id/actions"
                android:indeterminate="false"/>

            <TextView
                android:id="@+id/percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/progress_bar"
                android:layout_alignStart="@id/title"
                android:textSize="@dimen/text_super_small"/>

            <TextView
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/progress_bar"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/text_super_small"/>

        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
