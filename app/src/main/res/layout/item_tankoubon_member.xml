<?xml version="1.0" encoding="utf-8"?>
<!-- Single item layout for a tankoubon member archive row.
     Root background carries the ripple feedback for row taps; required. -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="Overdraw">

    <CheckBox
        android:id="@+id/member_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <com.lanraragi.framework.widget.LoadImageViewNew
        android:id="@+id/member_thumb"
        android:layout_width="56dp"
        android:layout_height="80dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:retryType="click" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/member_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/member_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Drag handle (spec 2026-09-21 §4): touching it starts the reorder drag;
         a long-press on the row itself enters multi-select instead. -->
    <ImageView
        android:id="@+id/member_drag_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:padding="12dp"
        android:src="@drawable/v_reorder_x24"
        android:contentDescription="@string/tank_drag_handle"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
