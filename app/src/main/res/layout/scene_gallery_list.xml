<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The list: one slot per GalleryListState (GalleryListDataHelper.render). -->
    <com.lanraragi.reader.widget.StateListLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Holds the skeleton the scene adds (the first load and refreshes). -->
        <FrameLayout
            android:id="@+id/state_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/state_empty"
            android:layout_width="228dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:drawablePadding="8dp"
            android:visibility="gone"
            style="@style/TextAppearance.AppCompat.Medium"/>

        <include
            android:id="@+id/state_message"
            layout="@layout/view_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/state_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.lanraragi.reader.widget.ListRefreshLayout
                android:id="@+id/refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.lanraragi.reader.widget.list.EasyRecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"/>

            </com.lanraragi.reader.widget.ListRefreshLayout>

            <com.lanraragi.reader.widget.list.FastScroller
                android:id="@+id/fast_scroller"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:paddingStart="20dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

        </FrameLayout>

    </com.lanraragi.reader.widget.StateListLayout>

    <com.lanraragi.reader.widget.SearchLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.lanraragi.reader.widget.SearchBar
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gallery_search_bar_margin_h"
        android:layout_marginEnd="@dimen/gallery_search_bar_margin_h"
        android:layout_marginTop="@dimen/gallery_search_bar_margin_v"
        style="@style/CardView.Normal"/>

    <com.lanraragi.framework.widget.FabLayout
        android:id="@+id/fab_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/corner_fab_margin"
        android:paddingBottom="@dimen/corner_fab_margin"
        tools:ignore="RtlSymmetry">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tag_filter"
            android:contentDescription="@string/cd_tag_filter"
            app:srcCompat="@drawable/ic_baseline_filter_none_24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            style="@style/Widget.Design.FloatingActionButton.Mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/refresh"
            app:srcCompat="@drawable/v_refresh_dark_x24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            style="@style/Widget.Design.FloatingActionButton.Mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="-1"
            android:contentDescription="@string/cd_random"
            app:srcCompat="@drawable/v_random_dark_x24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            style="@style/Widget.Design.FloatingActionButton.Mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_upload_archive"
            app:srcCompat="@drawable/v_upload_dark_x24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            style="@style/Widget.Design.FloatingActionButton.Mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_url_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/lrr_url_download_title"
            app:srcCompat="@drawable/v_link_dark_x24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            style="@style/Widget.Design.FloatingActionButton.Mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_expand_fab_menu"
            app:backgroundTint="?attr/widgetColorThemePrimary"
            style="@style/Widget.Design.FloatingActionButton"/>

    </com.lanraragi.framework.widget.FabLayout>

    <com.lanraragi.framework.widget.FabLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/corner_fab_margin"
        android:paddingBottom="@dimen/corner_fab_margin"
        tools:ignore="RtlSymmetry">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/search_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/search"
            app:srcCompat="@drawable/v_magnify_dark_x24"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            android:visibility="invisible"
            android:scaleX="0"
            android:scaleY="0"
            style="@style/Widget.Design.FloatingActionButton"/>

    </com.lanraragi.framework.widget.FabLayout>

    <include layout="@layout/widget_batch_action_bar"/>
</FrameLayout>
