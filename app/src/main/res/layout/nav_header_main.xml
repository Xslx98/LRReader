<!-- Branded drawer header (compact variant): launcher icon on a white rounded
     tile, app name + version beside it, and a status-pill showing the active
     LANraragi server below. Avatar / background / display-name customization
     was removed on purpose (2026-07-24) — this block is informational and
     must stay non-interactive. The server pill is bound by MainActivity from
     the active ServerProfile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nav_header_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="48dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/nav_header_logo_bg"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/nav_header_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_header_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nav_header_subtitle"
                android:textSize="11.5sp"
                tools:text="v1.18.3" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nav_header_server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:background="@drawable/nav_header_chip_bg"
        app:drawableStartCompat="@drawable/nav_header_server_dot"
        android:drawablePadding="7dp"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:maxWidth="236dp"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:text="@string/lrr_no_servers"
        android:textColor="@color/nav_header_title"
        android:textSize="11sp"
        tools:text="Homelab · 192.168.6.180:3000" />
</LinearLayout>
