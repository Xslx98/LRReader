<!--
  Detail-page page-thumbnail section. The RecyclerView is given a
  bounded height so view recycling actually engages — when nested
  in a NestedScrollView with wrap_content, GridLayoutManager lays
  out every itemCount cell up front, which on a 1000-page manhwa
  would mean ~1000 ImageView instances at once.

  RecyclerView opts in to nestedScrollingEnabled=true so the outer
  NestedScrollView hands off the scroll once the grid is on screen
  (standard NestedScrollView coordination).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/previews"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/keyline_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/page_thumb_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lrr_page_thumbnails_title"
            android:textColor="?attr/textColorThemeAccent"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/page_thumb_jump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/lrr_page_thumbnails_jump"
            android:textColor="?attr/textColorThemeAccent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/page_thumb_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/page_thumb_recycler"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gallery_detail_page_thumb_grid_max_height"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"/>

        <ProgressBar
            android:id="@+id/page_thumb_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/page_thumb_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/keyline_margin"
            android:gravity="center"
            android:textColor="?attr/textColorThemeAccent"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
