<com.hippo.widget.SafeCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hippo.ehviewer.widget.EhDrawerLayout
        android:id="@+id/draw_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.hippo.ehviewer.widget.EhStageLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.hippo.ehviewer.widget.EhNavigationView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?android:attr/windowBackground"
            android:maxWidth="@dimen/drawer_max_width"
            android:orientation="vertical"
            app:insetForeground="@android:color/transparent">

            <!-- Menu and theme-toggle row are stacked siblings (EhNavigationView
                 is a vertical LinearLayout), NOT an overlay: the drawer panel
                 spans screen-minus-56dp — far wider than the 280dp menu — and a
                 match_parent overlay child inflates a wrap_content ancestor to
                 that full panel width. As a LinearLayout sibling the row is
                 remeasured to the widest sibling (the menu), and stacking means
                 no menu item is ever occluded behind the row. -->
            <com.google.android.material.navigation.NavigationView
                android:id="@+id/nav_view"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?android:navigationBarColor"
                android:scrollbars="vertical"
                app:headerLayout="@layout/nav_header_main"
                app:insetForeground="@android:color/transparent"
                app:menu="@menu/nav_drawer_main" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:navigationBarColor"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- Footer-style row: typography comes from the same
                     textAppearanceSubtitle2 the NavigationView items use
                     (14sp / medium / letter-spacing), demoted to secondary
                     color and a 44dp row — full drawer width keeps the
                     touch target comfortable despite the shorter height. -->
                <TextView
                    android:id="@+id/change_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    app:drawableStartCompat="@drawable/v_theme_toggle_x24"
                    android:drawablePadding="14dp"
                    app:drawableTint="?android:attr/textColorSecondary"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="44dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </com.hippo.ehviewer.widget.EhNavigationView>

        <com.hippo.ehviewer.widget.EhDrawerView
            android:id="@+id/right_drawer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?android:attr/windowBackground"
            android:clickable="true"
            android:maxWidth="@dimen/drawer_max_width" />

    </com.hippo.ehviewer.widget.EhDrawerLayout>
</com.hippo.widget.SafeCoordinatorLayout>
