<com.lanraragi.framework.widget.SafeCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.lanraragi.reader.widget.AppDrawerLayout
        android:id="@+id/draw_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.lanraragi.reader.widget.AppStageLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.lanraragi.reader.widget.AppNavigationView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?android:attr/windowBackground"
            android:maxWidth="@dimen/drawer_max_width"
            android:orientation="vertical"
            app:insetForeground="@android:color/transparent">

            <!-- Menu and theme-toggle row are stacked siblings (AppNavigationView
                 is a vertical LinearLayout), NOT an overlay: the drawer panel
                 spans screen-minus-56dp — far wider than the 280dp menu — and a
                 match_parent overlay child inflates a wrap_content ancestor to
                 that full panel width. As a LinearLayout sibling the row is
                 remeasured to the widest sibling (the menu), and stacking means
                 no menu item is ever occluded behind the row. -->
            <com.google.android.material.navigation.NavigationView
                android:id="@+id/nav_view"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?android:navigationBarColor"
                android:scrollbars="vertical"
                app:headerLayout="@layout/nav_header_main"
                app:insetForeground="@android:color/transparent"
                app:menu="@menu/nav_drawer_main" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:navigationBarColor"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- Theme switch: one segment per theme, the current one
                     highlighted (MainNavDrawer.bindThemeSwitch); a tap
                     applies that theme directly. -->
                <LinearLayout
                    android:id="@+id/theme_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/theme_light"
                        style="@style/NavThemeSegment"
                        android:text="@string/settings_eh_theme_light" />

                    <TextView
                        android:id="@+id/theme_dark"
                        style="@style/NavThemeSegment"
                        android:text="@string/settings_eh_theme_dark" />

                    <TextView
                        android:id="@+id/theme_black"
                        style="@style/NavThemeSegment"
                        android:text="@string/settings_eh_theme_black" />

                </LinearLayout>
            </LinearLayout>
        </com.lanraragi.reader.widget.AppNavigationView>

        <com.lanraragi.reader.widget.AppDrawerView
            android:id="@+id/right_drawer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?android:attr/windowBackground"
            android:clickable="true"
            android:maxWidth="@dimen/drawer_max_width" />

    </com.lanraragi.reader.widget.AppDrawerLayout>
</com.lanraragi.framework.widget.SafeCoordinatorLayout>
