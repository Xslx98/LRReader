<resources>
    <!--前往theames.xml中设置具体值
        res/values/themes.xml-->
    <declare-styleable name="Theme">
        <!--   背景颜色     -->
        <attr name="android:windowBackground" format="color" />
        <attr name="android:navigationBarColor" format="color" />
        <attr name="buttonStyle" format="reference" />

        <attr name="colorEdgeEffect" format="color" />
        <attr name="dividerColor" format="color" />
        <attr name="toolbarColor" format="color" />

        <attr name="textColorThemePrimary" format="color" />
        <attr name="textColorThemePrimary2" format="color" />
        <attr name="textColorThemeAccent" format="color" />

        <!-- For light theme, it's primary dark color -->
        <!-- For dark theme, it's primary light color -->
        <!-- For black theme, it's primary light color -->
        <attr name="drawableColorPrimary" format="color" />
        <!-- For light theme, it's secondary dark color -->
        <!-- For dark theme, it's secondary light color -->
        <!-- For black theme, it's secondary light color -->
        <attr name="drawableColorSecondary" format="color" />
        <!-- For light theme, it's primary color -->
        <!-- For dark theme, it's primary light color -->
        <!-- For black theme, it's primary light color -->
        <attr name="drawableColorThemePrimary" format="color" />

        <!-- Color of card background -->
        <attr name="contentColorPrimary" format="color" />
        <attr name="contentColorThemePrimary" format="color" />
        <attr name="contentColorThemeAccent" format="color" />
        <attr name="contentColorReactive" format="color" />

        <attr name="widgetColorThemePrimary" format="color" />
        <attr name="widgetColorThemeAccent" format="color" />

        <attr name="guideBackgroundColor" format="color" />
        <attr name="guideTitleColor" format="color" />

        <attr name="progressColor" format="color" />

        <attr name="tagGroupBackgroundColor" format="color" />
        <!-- Label on a tagGroupBackgroundColor (namespace) chip. -->
        <attr name="tagGroupTextColor" format="color" />
        <attr name="tagBackgroundColor" format="color" />
        <!-- Label on a tagBackgroundColor (value) chip. -->
        <attr name="tagTextColor" format="color" />

        <!--
          Source-server badge palette. 8 slots indexed by
          (ServerProfile.id - 1) % 8 in DownloadAdapter.bindSourceBadge().
          Each slot has BG + FG channels following the Material 3
          "container / on-container" tonal pattern (also: GitHub Issues
          labels, Linear project chips):
            - Light theme: pastel BG (Tailwind 100) + deep FG (Tailwind 700)
            - Dark theme:  shade BG (Tailwind 900) + tint FG (Tailwind 200)
          Each theme overrides both channels in themes.xml. Project's
          manual theme switcher uses Activity.setTheme rather than uiMode,
          so values-night/ alone wouldn't adapt for users who pick
          Dark/Black on a light-mode system — attr indirection is required.
        -->
        <attr name="serverBadge0Bg" format="color" />
        <attr name="serverBadge1Bg" format="color" />
        <attr name="serverBadge2Bg" format="color" />
        <attr name="serverBadge3Bg" format="color" />
        <attr name="serverBadge4Bg" format="color" />
        <attr name="serverBadge5Bg" format="color" />
        <attr name="serverBadge6Bg" format="color" />
        <attr name="serverBadge7Bg" format="color" />
        <attr name="serverBadge0Fg" format="color" />
        <attr name="serverBadge1Fg" format="color" />
        <attr name="serverBadge2Fg" format="color" />
        <attr name="serverBadge3Fg" format="color" />
        <attr name="serverBadge4Fg" format="color" />
        <attr name="serverBadge5Fg" format="color" />
        <attr name="serverBadge6Fg" format="color" />
        <attr name="serverBadge7Fg" format="color" />

        <!-- RES-4: server-list row colors. Same attr-indirection rationale as
             the serverBadge palette above — the manual theme switcher uses
             Activity.setTheme, so -night resources would follow the SYSTEM
             dark mode instead of the app theme. -->
        <attr name="serverActiveRowBg" format="color" />
        <attr name="serverActiveNameColor" format="color" />
        <!-- Fill of a screen's one primary action button (white label, WCAG AA in every theme). -->
        <attr name="filledButtonColor" format="color" />

        <attr name="galleryDetailHeaderTitleColor" format="color" />
        <attr name="galleryDetailHeaderBackgroundColor" format="color" />
        <attr name="galleryDetailButtonBackgroundColor" format="color" />

        <attr name="gallerySliderBackgroundColor" format="color" />

        <attr name="preferenceHeaderBackground" format="reference" />

        <attr name="toolbarPopupTheme" format="reference" />
        <attr name="galleryDetailDivider" format="reference" />

        <attr name="limitCountBgColor" format="color"/>
        <attr name="iconColor" format="color"/>

        <attr name="limits_shape_color" format="color"/>
        <attr name="home_shadow" format="color"/>
    </declare-styleable>




    <declare-styleable name="LoadImageView">
        <attr name="image_radius" format="dimension" />
        <attr name="image_circle" format="boolean" />
        <attr name="retryType">
            <enum name="none" value="0" />
            <enum name="click" value="1" />
            <enum name="longClick" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="FixedThumb">
        <attr name="minAspect" format="float" />
        <attr name="maxAspect" format="float" />
    </declare-styleable>

    <declare-styleable name="FixedThumbNew">
        <!--        <attr name="minAspect" format="float" />-->
        <!--        <attr name="maxAspect" format="float" />-->
    </declare-styleable>

    <declare-styleable name="DividerView">
        <attr name="dividerWidth" format="dimension" />
        <attr name="dividerHeight" format="dimension" />
        <attr name="dividerColor" />
    </declare-styleable>









    <declare-styleable name="FullscreenAttrs">
        <attr name="fullscreenBackgroundColor" format="color" />
        <attr name="fullscreenTextColor" format="color" />
    </declare-styleable>

    <!-- 有描边的自定义TextView-->
    <declare-styleable name="StrokeTextView">
        <!--描边的颜色 -->
        <attr name="stroke_color" format="color" />
        <!-- 描边的宽度 -->
        <attr name="stroke_width" format="dimension" />
    </declare-styleable>
    <declare-styleable name="AppWidgetAttrs">
        <attr name="appWidgetPadding" format="dimension" />
        <attr name="appWidgetInnerRadius" format="dimension" />
        <attr name="appWidgetRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="SkeletonView">
        <attr name="skeletonShape" format="enum">
            <enum name="list" value="0" />
            <enum name="grid" value="1" />
            <enum name="text" value="2" />
        </attr>
        <attr name="skeletonCoverWidth" format="dimension" />
        <attr name="skeletonCoverHeight" format="dimension" />
    </declare-styleable>

</resources>
