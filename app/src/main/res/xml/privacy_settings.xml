<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.lanraragi.framework.preference.ActivityPreference
        android:key="pattern_protection"
        android:title="@string/settings_privacy_pattern_protection_title"
        app:activity="com.lanraragi.reader.ui.SetSecurityActivity"
        app:allowDividerAbove="true" />

    <com.lanraragi.framework.preference.SwitchPreference
        android:defaultValue="false"
        android:key="enable_secure"
        android:title="@string/settings_privacy_secure"
        app:summaryOff="@string/settings_privacy_secure_summary"
        app:summaryOn="@string/settings_privacy_secure_summary" />

    <com.lanraragi.framework.preference.SwitchPreference
        android:defaultValue="true"
        android:key="delete_confirm_countdown"
        android:title="@string/settings_privacy_delete_confirm_countdown"
        app:summaryOff="@string/settings_privacy_delete_confirm_countdown_summary_off"
        app:summaryOn="@string/settings_privacy_delete_confirm_countdown_summary_on" />

    <Preference
        android:key="clear_search_history"
        android:title="@string/settings_privacy_clear_search_history" />

    <!-- Self-signed HTTPS (audit C27 phase 2): see ServerTrust. -->
    <Preference
        android:key="import_ca_certificate"
        android:title="@string/settings_privacy_import_ca"
        android:summary="@string/settings_privacy_import_ca_summary" />

    <Preference
        android:key="trusted_certificates"
        android:title="@string/settings_privacy_trusted_certificates" />

    <!-- LANraragi: Analytics settings removed (Firebase not used) -->

</PreferenceScreen>
