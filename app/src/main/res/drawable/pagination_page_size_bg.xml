<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/drawableColorThemePrimary" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:drawable="@drawable/v_arrow_drop_down_x16"
        android:end="2dp"
        android:gravity="end|center_vertical" />
</layer-list>
